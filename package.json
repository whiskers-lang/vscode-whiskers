{
  "name": "whiskers",
  "displayName": "Whiskers",
  "description": "Formatter and language support for Mustache and Whiskers templates",
  "version": "0.1.0",
  "publisher": "whiskers-language-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whiskers-lang/vscode-whiskers.git"
  },
  "bugs": {
    "url": "https://github.com/whiskers-lang/vscode-whiskers/issues"
  },
  "homepage": "https://github.com/whiskers-lang/vscode-whiskers",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "files": [
    "out/**/*.js",
    "out/**/*.js.map",
    "icons/**",
    "syntaxes/**",
    "language-configuration.json",
    "ThirdPartyNotices.txt",
    "README.md"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "whiskers",
        "aliases": ["Whiskers", "whiskers"],
        "extensions": [".whiskers", ".wsk"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mustache.svg",
          "dark": "./icons/mustache.svg"
        }
      },
      {
        "id": "mustache",
        "aliases": ["Mustache", "mustache"],
        "extensions": [".mustache", ".mst"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "whiskers",
        "scopeName": "text.whiskers",
        "path": "./syntaxes/whiskers.tmLanguage.json"
      },
      {
        "language": "mustache",
        "scopeName": "text.whiskers",
        "path": "./syntaxes/whiskers.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "whiskersDelimiter": ["support.constant.handlebars"],
          "whiskersComment": ["comment.block.mustache"],
          "whiskersSigil": ["keyword.control.mustache"],
          "whiskersSection": ["variable.other.mustache"],
          "whiskersVariable": ["variable.other.mustache"],
          "whiskersMetadata": ["support.variable.mustache"],
          "whiskersPartial": ["support.function.partial.mustache"],
          "whiskersLambda": ["support.function.mustache"],
          "whiskersStringArgument": ["string.quoted.double.mustache"],
          "whiskersNumberArgument": ["constant.numeric.mustache"],
          "whiskersAlias": ["variable.parameter.mustache"]
        }
      }
    ],
    "semanticTokenTypes": [
      { "id": "whiskersDelimiter", "superType": "operator", "description": "A Whiskers or Mustache tag delimiter." },
      { "id": "whiskersComment", "superType": "comment", "description": "A Whiskers or Mustache comment." },
      { "id": "whiskersSigil", "superType": "keyword", "description": "A Whiskers or Mustache tag sigil." },
      { "id": "whiskersSection", "superType": "variable", "description": "A Whiskers or Mustache section key." },
      { "id": "whiskersVariable", "superType": "variable", "description": "A Whiskers or Mustache variable." },
      { "id": "whiskersMetadata", "superType": "enumMember", "description": "A Whiskers metadata variable." },
      { "id": "whiskersPartial", "superType": "function", "description": "A Whiskers or Mustache partial template." },
      { "id": "whiskersLambda", "superType": "function", "description": "A Whiskers lambda invocation." },
      { "id": "whiskersStringArgument", "superType": "string", "description": "A quoted or unquoted Whiskers lambda string argument." },
      { "id": "whiskersNumberArgument", "superType": "number", "description": "A Whiskers lambda numeric argument." },
      { "id": "whiskersAlias", "superType": "variable", "description": "A Whiskers named scope alias." }
    ],
    "commands": [
      {
        "command": "whiskers.enablePlaintextContentHighlighting",
        "title": "Use Plain Text Content Highlighting",
        "category": "Whiskers",
        "icon": "$(eye-closed)"
      },
      {
        "command": "whiskers.disablePlaintextContentHighlighting",
        "title": "Use Default Content Highlighting",
        "category": "Whiskers",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "whiskers.enablePlaintextContentHighlighting",
          "when": "(resourceLangId == whiskers || resourceLangId == mustache) && config.whiskers.contentHighlighting != plaintext",
          "group": "navigation@100"
        },
        {
          "command": "whiskers.disablePlaintextContentHighlighting",
          "when": "(resourceLangId == whiskers || resourceLangId == mustache) && config.whiskers.contentHighlighting == plaintext",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Whiskers",
      "properties": {
        "whiskers.colorScheme": {
          "type": "string",
          "enum": ["theme", "custom", "ember", "harbor", "paper", "signal"],
          "enumItemLabels": ["Automatic", "Custom", "Ember & Sea Glass", "Harbor Signal", "Paper Ledger", "Signal on White"],
          "markdownEnumDescriptions": [
            "Use Ember with dark themes and Paper with light themes.",
            "Use semantic token colors from the active VS Code theme and `editor.semanticTokenColorCustomizations`.",
            "Use the warm dark palette shown in the color study.",
            "Use the cool dark palette shown in the color study.",
            "Use the warm light palette shown in the color study.",
            "Use the crisp light palette shown in the color study."
          ],
          "default": "theme",
          "scope": "resource",
          "markdownDescription": "Controls Whiskers syntax colors. `theme` automatically selects Ember for dark themes and Paper for light themes; `custom` uses VS Code semantic token colors without palette overrides."
        },
        "whiskers.contentHighlighting": {
          "type": "string",
          "enum": ["default", "plaintext"],
          "enumItemLabels": ["Default", "Plain Text"],
          "default": "default",
          "scope": "resource",
          "markdownDescription": "Controls highlighting outside Mustache tags. `default` uses the embedded HTML grammar; `plaintext` displays non-template content as ordinary editor text."
        },
        "whiskers.plaintextOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8,
          "scope": "resource",
          "markdownDescription": "Controls the opacity of content outside Mustache tags when `whiskers.contentHighlighting` is `plaintext`."
        },
        "whiskers.templateOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "scope": "resource",
          "markdownDescription": "Controls the opacity of Mustache and Whiskers tags."
        },
        "whiskers.templateRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "uniqueItems": true,
          "scope": "resource",
          "markdownDescription": "Directories searched first for partial definitions. Relative paths are resolved from the containing workspace folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src tests scripts",
    "test": "npm run compile && node --test tests/*.test.js",
    "check": "npm run lint && npm test",
    "check:version": "node scripts/validate-version.js",
    "package:check": "npm run check && vsce ls --no-dependencies | node scripts/validate-package.js",
    "package:vsix": "npm run package:check && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
