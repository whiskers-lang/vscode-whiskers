{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension: Examples",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--user-data-dir=/tmp/vscode-whiskers-test",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
